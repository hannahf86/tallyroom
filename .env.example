# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API Keys). Either the new or the legacy key formats work.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email reminders. Optional in development: without these, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: portal link included in reminder emails
APP_URL=http://localhost:3000/dashboard
# Protects the reminders endpoint. Any long random string.
CRON_SECRET=c84f69fcef414b468e2f44b47959f1c0c92df43003fd42f09aa8c83b8bdd0177

# Protects the month-end export. Any long random string, shared only with firm staff.
