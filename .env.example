# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API Keys). Either the new or the legacy key formats work.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email reminders. Optional in development: without these, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=

# Protects the month-end export. Any long random string, shared only with firm staff.
EXPORT_SECRET=